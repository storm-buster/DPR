ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_HOSTS=["http://localhost:3000", "http://127.0.0.1:3000"]

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=your-ai-api-key